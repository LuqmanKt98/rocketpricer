# One-time data migration (copy to .env.migration). NEVER commit the real file
# or the service-account JSON — they grant full admin access to your project.

# --- Source: Base44 (for scripts/base44-export.mjs) ---
BASE44_APP_ID=69c37219f83ff2b34462675d
BASE44_TOKEN=PASTE_AN_ADMIN_ACCESS_TOKEN_HERE
# BASE44_BASE_URL=https://base44.app
# BASE44_EXPORT_LIMIT=50000

# --- Destination: Firebase (for scripts/firebase-import.mjs) ---
FIREBASE_SERVICE_ACCOUNT=rocket-pricer-firebase-adminsdk-fbsvc-7f8bc90bc7.json
FIREBASE_DATABASE_URL=https://rocket-pricer-default-rtdb.asia-southeast1.firebasedatabase.app
ADMIN_EMAIL=admin@rocketpricer.com

# Set to true when you're ready to email everyone a "set your password" link.
SEND_RESET_EMAILS=false
# Set to true to clear analytics_events + invites before inserting (avoids
# duplicates if you run the import more than once).
WIPE_BEFORE_IMPORT=false
