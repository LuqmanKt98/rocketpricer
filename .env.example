# RocketPricer — app environment (copy to .env.local for local dev).
# In production, set the same VITE_* vars in Vercel → Settings → Environment Variables.

# --- Firebase (frontend) ---
# These are OPTIONAL — the project's web config is baked into src/api/firebaseClient.js.
# Set them only if you want to point the app at a different Firebase project.
# The API key is public by design (access is controlled by Auth + Database rules).
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=rocket-pricer.firebaseapp.com
# VITE_FIREBASE_DATABASE_URL=https://rocket-pricer-default-rtdb.asia-southeast1.firebasedatabase.app
# VITE_FIREBASE_PROJECT_ID=rocket-pricer
# VITE_FIREBASE_STORAGE_BUCKET=rocket-pricer.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=750982782101
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=G-8QC0WG1GRE

# --- Admin bootstrap (optional overrides; defaults baked into the app) ---
# VITE_ADMIN_EMAIL=admin@rocketpricer.com
# VITE_ADMIN_PASSWORD_SHA256=<sha256 of the admin password>

# --- Resend transactional email (server-side /api functions; NOT VITE_) ---
# These belong in Vercel env, not the browser bundle:
# RESEND_API_KEY=
# RESEND_FROM=Rocket Pricer <notify@rocketpricer.com>
# NOTIFY_TO=admin@rocketpricer.com
# ADMIN_API_KEY=<sha256 of the admin password>
